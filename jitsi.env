CONFIG=./data/jitsi
HTTP_PORT=127.0.0.1:18000
HTTPS_PORT=127.0.0.1:18443
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=zhsz
JWT_ALLOW_EMPTY=1
ENABLE_AUTO_OWNER=false
XMPP_MUC_MODULES=muc_jwt_owner
JICOFO_MAX_MEMORY=256m
VIDEOBRIDGE_MAX_MEMORY=512m
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1
ENABLE_P2P=0
CODEC_ORDER_JVB=["VP8","VP9","H264","AV1"]
CODEC_ORDER_JVB_MOBILE=["VP8","VP9","H264","AV1"]
JICOFO_REST_PORT=18888
JVB_COLIBRI_PORT=28080
TZ=Asia/Shanghai
