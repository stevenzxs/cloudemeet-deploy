#!/usr/bin/env bash
# CloudMeet 配置库 pre-commit hook
# 自动检查构建文件修改时是否更新了 inputs.sha256

set -e

# 获取暂存区修改的构建相关文件
CHANGED_BUILD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(build-tools/|config/|\.github/workflows/|skills/)' || true)

if [ -z "$CHANGED_BUILD_FILES" ]; then
    # 没有构建相关文件修改，跳过检查
    exit 0
fi

# 检查 inputs.sha256 是否也被修改
INPUTS_SHA256_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^build-tools/inputs\.sha256$' || true)

if [ -z "$INPUTS_SHA256_CHANGED" ]; then
    echo ""
    echo "❌ 错误：检测到构建文件修改，但 build-tools/inputs.sha256 未更新"
    echo ""
    echo "修改的构建文件："
    echo "$CHANGED_BUILD_FILES" | sed 's/^/  - /'
    echo ""
    echo "请执行以下操作："
    echo "  1. 重新计算修改文件的哈希并更新 inputs.sha256"
    echo "  2. 或运行: bash .githooks/update-inputs-sha256.sh"
    echo "  3. git add build-tools/inputs.sha256"
    echo ""
    echo "如需跳过此检查（不推荐）: git commit --no-verify"
    echo ""
    exit 1
fi

# 验证 inputs.sha256 中的哈希是否正确
echo "✓ 检测到 inputs.sha256 已更新，验证哈希..."

# 检出暂存区的 inputs.sha256 到临时文件
TEMP_SHA256=$(mktemp)
git show :build-tools/inputs.sha256 > "$TEMP_SHA256"

# 验证哈希（排除 inputs.sha256 自身和 .new 文件）
VALIDATION_FAILED=false
while IFS= read -r line; do
    # 跳过空行和注释
    if [[ -z "$line" || "$line" =~ ^# ]]; then
        continue
    fi
    
    # 跳过 inputs.sha256 自身（会在最后单独验证）
    if [[ "$line" =~ inputs\.sha256$ ]] && [[ ! "$line" =~ inputs\.sha256\.new$ ]]; then
        continue
    fi
    
    # 提取哈希和文件路径
    expected_hash=$(echo "$line" | awk '{print $1}')
    file_path=$(echo "$line" | awk '{print $2}')
    
    # 检查文件是否存在
    if [ ! -f "$file_path" ]; then
        echo "⚠ 警告：$file_path 在 inputs.sha256 中但文件不存在"
        continue
    fi
    
    # 计算实际哈希
    actual_hash=$(sha256sum "$file_path" | awk '{print $1}')
    
    if [ "$expected_hash" != "$actual_hash" ]; then
        echo "❌ 哈希不匹配：$file_path"
        echo "   期望: $expected_hash"
        echo "   实际: $actual_hash"
        VALIDATION_FAILED=true
    fi
done < "$TEMP_SHA256"

rm -f "$TEMP_SHA256"

if [ "$VALIDATION_FAILED" = true ]; then
    echo ""
    echo "inputs.sha256 中的哈希与实际文件不一致"
    echo "请运行: bash .githooks/update-inputs-sha256.sh"
    echo ""
    exit 1
fi

echo "✓ inputs.sha256 验证通过"
exit 0
