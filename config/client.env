# Electron MSI / Android APK 客户端入口的唯一维护源。
# 填写客户端实际访问的外层入口；不从服务端 target.env 或 .env 推导。
# 仅公开入口参数，禁止放密码、JWT secret、证书私钥。
SITE_DOMAIN=cloudmeet.stevenzxs.cn
SITE_SCHEME=https
SITE_PORT=443

# Electron MSI / Android APK 共用的发布版本号。
CLIENT_VERSION=1.0.21

# 每批构建前明确选择 private-ca 或 caddy-public-acme。
# 公共模式要求HTTPS域名443，删除CLIENT_CA_FILE；目标Caddy联网签发/续期，不回退私有CA。
TLS_MODE=private-ca

# 客户端信任的公开 CA 文件；相对路径以本 client.env 所在目录为基准。
# 将本次服务器证书对应的 ca.crt 放到 deploy/cert/ca.crt。
# 只放公开 CA，不放 ca.key 或 server.key；客户端仍须校验证书有效期及主机/IP。
CLIENT_CA_FILE=client-ca.crt
