# jitsi-mgr User Management System Configuration
# This file contains non-sensitive configuration for jitsi-mgr service

# Database Configuration
# Production: Use PostgreSQL
# JITSI_MGR_DB_URL=jdbc:postgresql://postgres:5432/jitsi_mgr
# Development: Use H2 (default)
JITSI_MGR_DB_URL=jdbc:h2:file:/app/data/jitsi-mgr
JITSI_MGR_DB_USER=sa
# JITSI_MGR_DB_PASSWORD - Set in .env (required secret)

# Spring Profile
# Options: dev, prod
JITSI_MGR_PROFILE=prod

# JWT Configuration (RS256)
# Keys should be generated and placed in /app/data/keys/
# - jwt-private.pem: Private key for signing
# - jwt-public.pem: Public key for validation
# JWT_PRIVATE_KEY_PATH=/app/data/keys/jwt-private.pem
# JWT_PUBLIC_KEY_PATH=/app/data/keys/jwt-public.pem

# JWKS endpoint will be available at:
# https://{SITE_HOST}/api/mgr/v1/auth/jwks

# CORS Configuration
# CORS_ALLOWED_ORIGINS - Set from PUBLIC_URL in docker-compose.yml

# Initial Admin User
# Created automatically on first startup if not exists
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD - Set in .env (required secret)
# ADMIN_DISPLAY_NAME=System Administrator
# ADMIN_EMAIL=admin@cloudmeet.local
