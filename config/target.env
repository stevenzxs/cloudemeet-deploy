# 目标实例的非秘密配置；主机地址只在 SERVER_HOST 定义一次。
# 当前用于单机 IP HTTPS 部署；不放密码、JWT secret 或 CA 私钥。
SERVER_HOST=47.96.221.94
SITE_SCHEME=https
HTTPS_PORT=8443
HTTP_PORT=8080
MEDIA_PORT=10000

# 配置加载器自动派生，无需在本文件重复填写：
# SITE_HOST ← SERVER_HOST
# PUBLIC_URL ← SITE_SCHEME + "://" + SERVER_HOST + ":" + HTTPS_PORT
# JVB_ADVERTISE_IPS ← SERVER_HOST（当前单机 IP 场景）
# 仅修改源文件不会改变已有包或运行实例；需重新打包或显式更新实例。
