{
    auto_https disable_redirects
    skip_install_trust
    # Fallback certificate identity only; never an external redirect or Host filter.
    default_sni cloudmeet.internal
    fallback_sni cloudmeet.internal
}

# Do not guess the port of an external TCP forwarding rule.
http://:80 {
    respond "Use HTTPS on the configured external port." 426
}

(meeting_routes) {
    @internal path /internal /internal/* /mapi/internal /mapi/internal/*
    handle @internal {
        respond 404
    }
    @business path /cm /cm/* /mapi /mapi/* /healthz
    handle @business {
        reverse_proxy app-web:80
    }
    handle {
        reverse_proxy web:8000
    }
}

https://cloudmeet.internal {
    tls internal
    import meeting_routes
}

# Catch-all routing: HTTP Host is not tied to the certificate's local identity.
https://:443 {
    tls internal
    import meeting_routes
}

# Internal container-network listener: never publish port 9443 on the host.
https://gateway:9443 {
    tls /host-control/gateway.crt /host-control/gateway.key
    @allowed {
        method POST
        path /internal/host-role/v1/check /internal/host-role/v1/rotate /internal/host-role/v1/complete /internal/host-role/v1/status /internal/host-role/v1/rebind /internal/host-role/v1/claim /internal/host-role/v1/reclaim
    }
    handle @allowed {
        rewrite * /mapi{uri}
        reverse_proxy api:9000
    }
    handle {
        respond 404
    }
}
