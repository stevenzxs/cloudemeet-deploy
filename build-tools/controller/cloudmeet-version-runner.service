[Unit]
Description=CloudMeet restricted version allocator runner
Wants=network-online.target
After=network-online.target

[Service]
User=cloudmeet-runner
Group=cloudmeet-runner
WorkingDirectory=/opt/cloudmeet-version-controller/runner
Environment=HOME=/opt/cloudmeet-version-controller/home
ExecStart=/opt/cloudmeet-version-controller/runner/run.sh
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/cloudmeet-version-controller
InaccessiblePaths=-/opt/stevenzxs-hermes -/opt/data -/run/docker.sock -/run/containerd -/var/lib/docker -/var/lib/containerd

[Install]
WantedBy=multi-user.target
