# Set each image reference to the same-batch digest from images.json.
IMAGE_GATEWAY=ghcr.io/stevenzxs/cloudmeet-gateway@sha256:REPLACE
IMAGE_APP_WEB=ghcr.io/stevenzxs/cloudmeet-app-web@sha256:REPLACE
IMAGE_API=ghcr.io/stevenzxs/cloudmeet-api@sha256:REPLACE
IMAGE_JITSI_MGR=ghcr.io/stevenzxs/cloudmeet-jitsi-mgr@sha256:REPLACE
IMAGE_WEB=ghcr.io/stevenzxs/cloudmeet-web@sha256:REPLACE
IMAGE_PROSODY=ghcr.io/stevenzxs/cloudmeet-prosody@sha256:REPLACE
IMAGE_JICOFO=ghcr.io/stevenzxs/cloudmeet-jicofo@sha256:REPLACE
IMAGE_JVB=ghcr.io/stevenzxs/cloudmeet-jvb@sha256:REPLACE

# Site/media target values; choose the Caddyfile matching the approved TLS mode.
PUBLIC_URL=https://meet.example.com
MEDIA_PORT=10000
MEDIA_HOST=REPLACE_WITH_PUBLIC_MEDIA_IPV4

# Generate unique random values on the target host. Never commit real values.
JWT_APP_ID=cloudmeet
JWT_APP_SECRET=REPLACE_WITH_RANDOM_SECRET
JICOFO_AUTH_PASSWORD=REPLACE_WITH_RANDOM_SECRET
JVB_AUTH_PASSWORD=REPLACE_WITH_RANDOM_SECRET
JITSI_ROLE_CHECK_SECRET=REPLACE_WITH_RANDOM_SECRET
